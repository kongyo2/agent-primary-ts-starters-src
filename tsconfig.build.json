{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": ["src/lib/**/*", "src/schemas/**/*", "bin/**/*"],
  "exclude": [
    "node_modules",
    "skills",
    "scripts",
    "vitest.config.ts",
    "src/data/**",
    "**/*.test.ts",
    "**/__fixtures__/**"
  ]
}
